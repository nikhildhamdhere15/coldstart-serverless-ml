# AWS Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=ETLFeatureData

# SageMaker Endpoints
XGBOOST_ENDPOINT=cold-start-xgboost-serverless
RF_ENDPOINT=cold-start-rf-serverless

# Lambda Functions
TRAFFIC_GENERATOR_FUNCTION=TrafficGenerator
DATA_AGGREGATOR_FUNCTION=DataAggregator
INTELLIGENT_WARMER_FUNCTION=IntelligentLambdaWarmer

# API Gateway
API_GATEWAY_URL=https://your-api-gateway-url.amazonaws.com

# Dashboard Configuration
DASHBOARD_TITLE=Cold Start Prevention Dashboard
AUTO_REFRESH_INTERVAL=30
MAX_RECORDS_DISPLAY=50
PREDICTION_TIMEOUT=10

# External Access Configuration
PUBLIC_PORT=8501
SERVER_ADDRESS=0.0.0.0
ENABLE_CORS=false
ENABLE_XSRF_PROTECTION=false
SESSION_TIMEOUT=3600
MAX_CONCURRENT_USERS=10

# Security Settings for External Access
SHOW_ERROR_DETAILS=false
GATHER_USAGE_STATS=false
TOOLBAR_MODE=minimal

# ngrok Configuration (for public URL)
NGROK_AUTH_TOKEN=your_ngrok_token_here